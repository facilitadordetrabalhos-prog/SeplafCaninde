# Seplaf Canindé — backend. Copie para .env e preencha. Nunca versione o .env.
# Porta HTTP (a hospedagem pode definir PORT); o servidor escuta em 0.0.0.0
PORT=3000
NODE_ENV=development

# Banco: sqljs (arquivo data/seplaf.sqlite, desenvolvimento), mysql (MySQL/MariaDB, ex.: Hostinger) ou postgres
DB_TYPE=sqljs
# mysql://usuario:senha@host:3306/banco  ou  postgres://usuario:senha@host:5432/banco
DATABASE_URL=
# Alternativa ao DATABASE_URL (mysql/postgres):
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
# Em produção (NODE_ENV=production) o schema só é criado/atualizado automaticamente com DB_SYNC=true.
# Use DB_SYNC=true na PRIMEIRA implantação para criar as tabelas; depois pode voltar para false.
DB_SYNC=false
# Opcional (postgres/mysql): true para conexão SSL sem validar certificado
DB_SSL=

# Obrigatório: segredo longo e aleatório
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Primeiro gestor, criado no boot se não existir nenhum usuário
ADMIN_NOME=Administrador
ADMIN_EMAIL=
ADMIN_SENHA=

# E-mail (sem SMTP_HOST os e-mails são apenas registrados no log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Secretaria de Finanças de Canindé <nao-responda@exemplo.gov.br>"

# Endereço público do portal (usado nos links dos e-mails)
PUBLIC_URL=http://localhost:5173
# Origens extras permitidas no CORS (separadas por vírgula). Em desenvolvimento http://localhost:5173 já é liberado.
CORS_ORIGIN=

# Sincronização das notícias do CGIBS
CGIBS_SYNC_CRON=0 */2 * * *
CGIBS_SYNC_ATIVO=true
